<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
>
    <Dialog
        id="hcChatDialog"
        title="Questions &amp; Answers"
        contentWidth="45rem"
        contentHeight="32rem"
        resizable="true"
        draggable="true"
    >
        <content>
            <VBox id="qaRootBox" class="sapUiSmallMargin">

                <!-- ── Add row ── -->
                <HBox
                    id="qaAddRow"
                    justifyContent="End"
                    class="sapUiSmallMarginBottom"
                >
                    <Button
                        id="btnAddQAPair"
                        icon="sap-icon://add"
                        text="Add Question"
                        type="Emphasized"
                        press=".onAddQAPair"
                    />
                </HBox>

                <!-- ── Q&A list ── -->
                <List
                    id="qaList"
                    items="{qa>/pairs}"
                    noDataText="No questions added yet"
                    showSeparators="Inner"
                >
                    <CustomListItem id="qaListItem">
                        <VBox
                            id="qaPairBox"
                            class="sapUiSmallMarginBottom sapUiSmallMarginTop"
                            width="100%"
                        >
                            <HBox
                                id="qaQuestionRow"
                                alignItems="Center"
                                width="100%"
                            >
                            <Label text="Question" width="5rem"/>
                                <Input
                                    id="qaQuestionInput"
                                    value="{qa>question}"
                                    placeholder="Enter question"
                                    width="35rem"
                                    class="sapUiTinyMarginEnd"
                                />
                                <Button
                                    id="btnRemoveQAPair"
                                    icon="sap-icon://delete"
                                    type="Transparent"
                                    tooltip="Remove"
                                    enabled="{= !${qa>confirmed} }"
                                    press=".onRemoveQAPair"
                                />
                            </HBox>
                            <HBox width="100%">
                            <Label text="Answer" width="5rem"/>
                            <TextArea
                                id="qaAnswerText"
                                value="{qa>answer}"
                                placeholder="Enter answer"
                                rows="4"
                                width="35rem"
                                growing="true"
                                class="sapUiTinyMarginTop"
                            />
                            </HBox>
                        </VBox>
                    </CustomListItem>
                </List>
            </VBox>
        </content>

        <beginButton>
            <Button
                id="btnSaveQAPairs"
                text="Save"
                type="Emphasized"
                press=".onSaveQAPairs"
            />
        </beginButton>
        <endButton>
            <Button
                id="btnCloseHCDialog"
                text="Close"
                press=".onCloseHCDialog"
            />
        </endButton>
    </Dialog>
</core:FragmentDefinition>