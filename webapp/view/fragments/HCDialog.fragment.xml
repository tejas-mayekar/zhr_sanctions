<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
>
    <Dialog
        id="hcChatDialog"
        title="Questions &amp; Answers"
        contentWidth="45rem"
        contentHeight="32rem"
        resizable="true"
        draggable="true"
    >
        <content>
            <VBox id="qaRootBox" class="sapUiSmallMargin">

                <!-- ── Add row ── -->
                <HBox
                    id="qaAddRow"
                    justifyContent="End"
                    class="sapUiSmallMarginBottom"
                >
                    <Button
                        id="btnAddQAPair"
                        icon="sap-icon://add"
                        text="Add Question"
                        type="Emphasized"
                        press=".onAddQAPair"
                    />
                </HBox>

                <!-- ── Q&A list ── -->
                <List
                    id="qaList"
                    items="{qa>/pairs}"
                    noDataText="No questions added yet"
                    showSeparators="Inner"
                >
                    <CustomListItem id="qaListItem">
                        <VBox
                            id="qaPairBox"
                            class="sapUiSmallMarginBottom sapUiSmallMarginTop"
                            width="100%"
                        >
                            <!-- ══ READ-ONLY view (loaded from QNA_SETSet) ══ -->
                            <VBox
                                id="qaDisplayBox"
                                visible="{= !!${qa>confirmed} }"
                                class="sapUiTinyMarginBottom"
                                width="100%"
                            >
                                <HBox id="qaQuestionDisplayRow" alignItems="Start" width="100%">
                                    <Label
                                        id="qaQuestionLabel"
                                        text="Q:"
                                        width="2rem"
                                        design="Bold"
                                        class="sapUiTinyMarginEnd"
                                    />
                                    <Text
                                        id="qaQuestionText"
                                        text="{qa>question}"
                                        wrapping="true"
                                        width="38rem"
                                    />
                                </HBox>
                                <HBox id="qaAnswerDisplayRow" alignItems="Start" width="100%" class="sapUiTinyMarginTop">
                                    <Label
                                        id="qaAnswerLabel"
                                        text="A:"
                                        width="2rem"
                                        design="Bold"
                                        class="sapUiTinyMarginEnd"
                                    />
                                    <Text
                                        id="qaAnswerText"
                                        text="{qa>answer}"
                                        wrapping="true"
                                        width="38rem"
                                    />
                                </HBox>
                            </VBox>

                            <!-- ══ EDITABLE view (new pairs added by user) ══ -->
                            <VBox
                                id="qaEditBox"
                                visible="{= !${qa>confirmed} }"
                                width="100%"
                            >
                                <HBox
                                    id="qaQuestionRow"
                                    alignItems="Center"
                                    width="100%"
                                >
                                    <Label text="Question" width="5rem"/>
                                    <Input
                                        id="qaQuestionInput"
                                        value="{qa>question}"
                                        placeholder="Enter question"
                                        width="33rem"
                                        class="sapUiTinyMarginEnd"
                                    />
                                    <Button
                                        id="btnRemoveQAPair"
                                        icon="sap-icon://delete"
                                        type="Transparent"
                                        tooltip="Remove"
                                        press=".onRemoveQAPair"
                                    />
                                </HBox>
                                <HBox width="100%" class="sapUiTinyMarginTop">
                                    <Label text="Answer" width="5rem"/>
                                    <TextArea
                                        id="qaAnswerInput"
                                        value="{qa>answer}"
                                        placeholder="Enter answer"
                                        rows="4"
                                        width="33rem"
                                        growing="true"
                                    />
                                </HBox>
                            </VBox>
                        </VBox>
                    </CustomListItem>
                </List>
            </VBox>
        </content>

        <beginButton>
            <Button
                id="btnSaveQAPairs"
                text="Save"
                type="Emphasized"
                press=".onSaveQAPairs"
            />
        </beginButton>
        <endButton>
            <Button
                id="btnCloseHCDialog"
                text="Close"
                press=".onCloseHCDialog"
            />
        </endButton>
    </Dialog>
</core:FragmentDefinition>